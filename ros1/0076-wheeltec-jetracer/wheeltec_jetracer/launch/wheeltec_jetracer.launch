<launch>
  <node pkg="wheeltec_jetracer" type="road_following.py" name="wheeltec_jetracer"  output="screen">
	<param name="normal_vel"          value="0.15" />	<!--小车常规速度-->
	<param name="STEERING_GAIN"          value="0.5" />   <!--转向增益 参数推荐设置-->
							        <!--for miniakm:(normal_vel,STEERING_GAIN)=(0.1,0.35)/(0.15,0.4)/(0.2,0.6)-->
							        <!--for minimec:(normal_vel,STEERING_GAIN)=(0.1,0.6)/(0.15,0.8)/(0.2,1.1)-->
	<param name="STEERING_BIAS"          value="0.02" />    <!--车道中间调节 调大STEERING_BIAS向左偏移  调小STEERING_BIAS小车向右偏移,可为负数-->
	<param name="if_akm_yes_or_no"          value="yes" />
  </node>

  <!-- 开启激光雷达跟随节点  -->
  <include file='$(find simple_follower)/launch/nodes/laserTracker.launch' />
  <!-- 开启机器人底层相关节点  -->
  <include file="$(find turn_on_wheeltec_robot)/launch/turn_on_wheeltec_robot.launch" />
  <!-- turn on lidar开启雷达  -->
  <include file="$(find turn_on_wheeltec_robot)/launch/wheeltec_lidar.launch" />
</launch>
