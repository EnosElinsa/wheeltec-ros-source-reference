<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_view"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@drawable/background2"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/top_view"
        android:layout_width="fill_parent"
        android:layout_height="50dip"
        android:background="#00404040"
        android:orientation="horizontal">

        <Button
            android:id="@+id/back_button"
            style="@style/but_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="back"
            android:text="@string/go_back" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TextView"
            android:textColor="#f49810"
            android:textSize="18sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/choose_map_button"
                android:layout_width="wrap_content"
                android:layout_height="50dip"
                android:onClick="chooserMap"
                android:text="@string/choose_a_map"
                android:visibility="invisible" />

            <RadioGroup
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="right"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/top_bar"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:background="#ff404040"
                    android:gravity="right"
                    android:orientation="horizontal"
                    android:visibility="invisible" />

                <RadioButton
                    android:id="@+id/set_goal_button"
                    android:layout_width="113dp"
                    android:layout_height="50dp"
                    android:checked="true"
                    android:onClick="setGoalClicked"
                    android:text="@string/singleNav"
                    android:textColor="#3BF1CD" />

                <RadioButton
                    android:id="@+id/set_pose_button"
                    android:layout_width="106dp"
                    android:layout_height="50dp"
                    android:onClick="setPoseClicked"
                    android:text="@string/clicked_point"
                    android:textColor="#3BF1CD" />

            </RadioGroup>

        </FrameLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/main_layout"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/side_layout"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_weight=".75"
                android:gravity="right"
                android:orientation="vertical">

                <org.ros.android.view.visualization.VisualizationView
                    android:id="@+id/map_view"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_weight=".25" />

                <org.ros.android.view.VirtualJoystickView
                    android:id="@+id/virtual_joystick"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_weight=".25"
                    android:adjustViewBounds="true" />
            </LinearLayout>

            <org.ros.android.view.RosImageView
                android:id="@+id/image"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_gravity="center"
                android:layout_weight=".25"
                android:src="@drawable/camera" />


        </LinearLayout>

    </FrameLayout>

</LinearLayout>
