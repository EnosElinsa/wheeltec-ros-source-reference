<launch>
    <arg name="rplidar_mode"  default="ls_M10P_double" 
    doc="opt: rplidar_A1_A2, rplidar_A3, rplidar_S1, ls_M10P_double,ls_M10 ,ls_M10P_uart"/>

    <arg name="Ultrasonic_Avoid" default="false"/>
    <!-- 思岚雷达参数 -->
    <!--单角度分割-->
    <param name="/rplidarNode/angle_start"         type="double" value="0"  />   <!-- 扫描起始角度-->
    <param name="/rplidarNode/angle_end"           type="double" value="360"/>   <!-- 扫描结束角度-->
    <!-- <param name="/rplidarNode/angle_start"         type="double" value="270"/> -->   <!-- A1_moveit扫描起始角度-->
    <!-- <param name="/rplidarNode/angle_end"           type="double" value="90"/>  -->   <!-- A1_moveit扫描结束角度-->
    <!--<param name="/rplidarNode/angle_start"         type="double" value="315"/>-->   <!-- A2_moveit扫描起始角度-->
    <!--<param name="/rplidarNode/angle_end"           type="double" value="135"/>-->   <!-- A2_moveit扫描结束角度-->
    <!--<param name="/rplidarNode/angle_start"         type="double" value="250"/>-->   <!-- 服务机器人扫描起始角度-->
    <!--<param name="/rplidarNode/angle_end"           type="double" value="110"/>-->   <!-- 服务机器人扫描结束角度-->
    <param name="/rplidarNode/distance_min"        type="double" value="0"  /> <!-- 最小扫描距离-->
    <param name="/rplidarNode/distance_max"        type="double" value="30" /> <!-- 最大扫描距离-->
    <!--多角度分割-->
    <param name="/rplidarNode/is_parted"           type="bool"   value="false"/> <!--角度是否分割-->
    <param name="/rplidarNode/angle1_start"        type="double" value="40"/> <!--第一个屏蔽角度的起始角度-->
    <param name="/rplidarNode/angle1_end"          type="double" value="50"/> <!--第一个屏蔽角度的结束角度-->
    <param name="/rplidarNode/angle2_start"        type="double" value="130"/> <!--第二个屏蔽角度的起始角度--> 
    <param name="/rplidarNode/angle2_end"          type="double" value="140"/> <!--第二个屏蔽角度的结束角度--> 
    <param name="/rplidarNode/angle3_start"        type="double" value="220"/> <!--第三个屏蔽角度的起始角度-->
    <param name="/rplidarNode/angle3_end"          type="double" value="230"/> <!--第三个屏蔽角度的结束角度-->
    <param name="/rplidarNode/angle4_start"        type="double" value="310"/> <!--第四个屏蔽角度的起始角度-->
    <param name="/rplidarNode/angle4_end"          type="double" value="320"/> <!--第四个屏蔽角度的结束角度-->  
    <!-- 思岚雷达参数 -->

    <!-- 镭神M10  N10雷达参数 -->
    <param name="lslidar_x10_driver_node/truncated_mode" value="0"/>    <!--0:不屏蔽角度 1:屏蔽角度-->
    <rosparam param="lslidar_x10_driver_node/disable_min">[120]</rosparam> <!--角度左值-->
    <rosparam param="lslidar_x10_driver_node/disable_max">[240]</rosparam> <!--角度右值-->

    <!-- 启动思岚A1/A2雷达 -->
    <group if="$(eval rplidar_mode == 'rplidar_A1_A2')">
        <include file="$(find rplidar_ros)/launch/rplidar.launch"/>
    </group>

    <!-- 启动思岚A3雷达 -->
    <group if="$(eval rplidar_mode == 'rplidar_A3')">
        <include file="$(find rplidar_ros)/launch/rplidar_a3.launch"/>
    </group>

        <!-- 启动镭神M10P_uart雷达 -->
    <group if="$(eval rplidar_mode == 'ls_M10P_uart')">
        <include file="$(find lslidar_x10_driver)/launch/lslidar_x10_serial.launch"/>
        <param name="lslidar_x10_driver_node/lidar_name" value="M10_P"/> 
         <param name="lslidar_x10_driver_node/serial_port" value="/dev/wheeltec_lidar1"/>
    </group>


    <!-- 启动思岚S1雷达 -->
    <group if="$(eval rplidar_mode == 'rplidar_S1')">
        <include file="$(find rplidar_ros)/launch/rplidar_s1.launch"/>
    </group>

    <!-- 启动镭神M10雷达 -->
    <group if="$(eval rplidar_mode == 'ls_M10')">
        <include file="$(find lsm10_v2)/launch/lsm10_v2.launch"/>
    </group>

    <!-- 启动双镭神M10p雷达 -->
    <group if="$(eval rplidar_mode == 'ls_M10P_double')">
        <include file="$(find laser_double)/launch/laser_double.launch">
            <arg name="if_double" value="true"/>
        </include>
        <param if="$(arg Ultrasonic_Avoid)" name="/lsm10_v2_double/scan_topic" value="scan_without_avoid"/><!--设置激光数据topic名称-->
        <!-- <param unless="$(arg Ultrasonic_Avoid)" name="/lsm10_v2_double/scan_topic" value="scan"/> --><!--设置激光数据topic名称-->
        <node if="$(arg Ultrasonic_Avoid)" pkg="turn_on_wheeltec_robot" type="lsm10_double_back" name="lsm10_double_back" output="screen">
            <!-- <param name="frame_id" type="string" value="laser_avoid"/> -->
            <param name="frame_id" type="string" value="laser_avoid"/>
            <param name="scan_topic_without_avoid" type="string" value="scan_without_avoid"/>
            <param name="scan_topic" type="string" value="scan"/>
            <param name="avoid_distance"  type="double" value="1.5"/>

            <param name="scan_A_angle"  type="double" value="30"/>
            <param name="scan_B_angle"  type="double" value="20"/>
            <param name="scan_C_angle"  type="double" value="10"/>
            <param name="scan_D_angle"  type="double" value="350"/>
            <param name="scan_E_angle"  type="double" value="340"/>
            <param name="scan_F_angle"  type="double" value="330"/>

            <param name="avoid_A_xoffset" type="double" value="0.4"/>
            <param name="avoid_B_xoffset" type="double" value="0.4"/>
            <param name="avoid_C_xoffset" type="double" value="0.4"/>
            <param name="avoid_D_xoffset" type="double" value="0.4"/>
            <param name="avoid_E_xoffset" type="double" value="0.4"/>
            <param name="avoid_F_xoffset" type="double" value="0.4"/>
            <param name="avoid_A_yoffset" type="double" value="0.275"/>
            <param name="avoid_B_yoffset" type="double" value="0.165"/>
            <param name="avoid_C_yoffset" type="double" value="0.055"/>
            <param name="avoid_D_yoffset" type="double" value="-0.055"/>
            <param name="avoid_E_yoffset" type="double" value="-0.165"/>
            <param name="avoid_F_yoffset" type="double" value="-0.275"/>
            <param name="avoid_A_rotate" type="double" value="0.7"/>
            <param name="avoid_B_rotate" type="double" value="0.0"/>
            <param name="avoid_C_rotate" type="double" value="0.0"/>
            <param name="avoid_D_rotate" type="double" value="0.0"/>
            <param name="avoid_E_rotate" type="double" value="0.0"/>
            <param name="avoid_F_rotate" type="double" value="-0.7"/>
        </node>
    </group>
</launch>
