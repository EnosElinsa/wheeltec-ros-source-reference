<launch>
  <!-- 开启机器人底层相关节点  -->
  <include file="$(find wheeltec_mic_aiui)/launch/include/voi_navigation1.launch" />
  <include file='$(find simple_follower)/launch/nodes/laserTracker.launch' />
  <rosparam command="load" file="$(find wheeltec_mic_aiui)/config/recognition_params.yaml" />

  <node pkg="wheeltec_mic_aiui" type="commandRecognition" name="commandRecognition" output="screen" />
  <node pkg="wheeltec_mic_aiui" type="motionControl" name="motionControl"/>
  <node pkg="wheeltec_mic_aiui" type="nodeFeedback" name="nodeFeedback" output="screen" />
  <node pkg="wheeltec_mic_aiui" type="pointNavigation" name="pointNavigation" />
</launch>
