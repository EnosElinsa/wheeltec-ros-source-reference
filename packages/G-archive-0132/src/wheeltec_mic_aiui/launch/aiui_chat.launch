<launch>
  
  <node pkg="wheeltec_mic_aiui" type="wheeltecMic" name="wheeltecMic" output="screen">
    <param name="usart_port_name"  type="string" value="/dev/wheeltec_mic"/>
  </node>

  <node pkg="wheeltec_mic_aiui" type="wheeltec_mic_aiui" name="wheeltec_mic_aiui" output="screen">
    <param name="source_path" type="string" value="$(find wheeltec_mic_aiui)"/>
  </node>

  <node pkg="wheeltec_mic_aiui" type="chatService" name="chatService" output="screen"/>

</launch>
