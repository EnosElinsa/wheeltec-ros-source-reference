<launch>
	<!-- 设置部分节点是否在终端打印信息 -->
	<arg name="output"  default="log"/>
	<!-- 设置里程计坐标名称 -->
	<arg name="odom_frame_id"  default="odom_combined"/>

	<!-- 开启自动回充功能-->
	<include file="$(find auto_recharge_ros)/launch/auto_recharger_node.launch" />

	<!-- 使用已有地图文件预创建地图  -->
	<arg name="map_file" default="$(find auto_recharge_ros)/map/WHEELTEC.yaml"/>
	<node name="map_server_for_test" pkg="map_server" type="map_server" args="$(arg map_file)">
	</node>
	
	<!-- turn on lidar开启雷达  -->
    <include file="$(find turn_on_wheeltec_robot)/launch/wheeltec_lidar.launch" />
    
    <!-- 多点导航节点 -->
	<node name='send_mark' pkg="turn_on_wheeltec_robot" type="send_mark.py">
	</node>

	<!-- 开启机器人底层相关节点  -->
	<include file="$(find turn_on_wheeltec_robot)/launch/turn_on_wheeltec_robot.launch">
		  <!-- 开启导航功能  -->
		  <arg name="navigation"  default="true"/>
		  <arg name="is_cartographer" value="false"/>
		  <arg name="odom_frame_id"   value="$(arg odom_frame_id)"/>
		  <arg name="output"  default="$(arg output)"/>
	</include>
	<!-- 开启用于导航的自适应蒙特卡洛定位amcl-->
 	<include file="$(find turn_on_wheeltec_robot)/launch/include/amcl.launch" />

</launch>